# TweedDay for Ghostty, part of cosmic-tweedday-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = TweedDay
# or, with the Tweed half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Tweed,light:TweedDay

